# Copy to .env for local development only. NEVER commit actual values.
DATABASE_URL=
PORT=3000
PUBLIC_APP_URL=https://moneycash-sigma-one.vercel.app
ALLOWED_ORIGINS=
DB_CONNECTION_LIMIT=16
# Enable ONLY for plain HTTP loopback development, never production.
MONEYTRACK_LOCAL_HTTP=false
# SMTP is intentionally unconfigured in this release.
SMTP_URL=
SMTP_FROM=
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
SMTP_SECURE=true
# Optional native recurring scheduler: leave blank until explicitly configured.
CRON_SECRET=
# One-time bootstrap only. Remove these variables after the first creation.
MONEYTRACK_ADMIN_EMAIL=
MONEYTRACK_ADMIN_NAME=
MONEYTRACK_ADMIN_PASSWORD=
