{
  "name": "moneytrack",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "description": "Bilingual multi-user finance platform — HTML, CSS, Vanilla JavaScript, Node.js and MySQL",
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "node --env-file-if-exists=.env server/index.js",
    "start": "node --env-file-if-exists=.env server/index.js",
    "build": "node scripts/build.js",
    "migrate": "node --env-file-if-exists=.env server/migrate.js",
    "bootstrap:admin": "node --env-file-if-exists=.env scripts/bootstrap-admin.js",
    "test": "node --test tests/*.test.js",
    "test:integration": "node --env-file-if-exists=.env --test tests/integration/*.test.js",
    "vercel-build": "node scripts/build.js"
  },
  "dependencies": {
    "express": "5.3.0",
    "mysql2": "3.24.6",
    "nodemailer": "10.5.0",
    "cookie-parser": "1.4.7"
  },
  "devDependencies": {
    "smtp-server": "3.21.4"
  }
}
