{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "pnpm run build",
  "installCommand": "pnpm install --frozen-lockfile",
  "functions": {
    "app.js": {
      "includeFiles": ["dist/**", "db/migrations/**", "js/**"],
      "maxDuration": 60,
      "memory": 1024
    }
  },
  "crons": [
    { "path": "/api/cron/recurring", "schedule": "0 * * * *" }
  ]
}
